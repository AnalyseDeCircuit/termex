<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.termex.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Adjust to absolute path if termexd is not on $HOME/.local/bin -->
    <string>/Users/_USER_/.local/bin/termexd</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/_USER_/.termex/termexd.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/_USER_/.termex/termexd.log</string>
</dict>
</plist>
