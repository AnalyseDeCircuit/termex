default_platform(:android)

platform :android do
  # ── Internal track ────────────────────────────────────────────────────────
  desc "Upload AAB to Play Store internal track"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: "../../app/build/app/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key_data: ENV["PLAY_STORE_JSON_KEY"]
    )
  end

  # ── Open Beta ─────────────────────────────────────────────────────────────
  desc "Promote internal to open beta"
  lane :beta do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "beta",
      skip_upload_apk: true,
      skip_upload_aab: true,
      json_key_data: ENV["PLAY_STORE_JSON_KEY"]
    )
  end

  # ── Production (graduated rollout) ────────────────────────────────────────
  desc "Upload AAB and submit for production (10% rollout)"
  lane :deploy do
    upload_to_play_store(
      track: "production",
      rollout: "0.1",
      aab: "../../app/build/app/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key_data: ENV["PLAY_STORE_JSON_KEY"]
    )
  end
end
