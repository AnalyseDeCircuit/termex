<?xml version="1.0" encoding="utf-8"?>
<!-- Termex doesn't differentiate light vs dark themes; the night-mode
     resource set keeps the exact same chrome as values/styles.xml so
     the user gets a uniform dark experience regardless of system mode. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/termex_background_secondary</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/termex_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/termex_background_secondary</item>
    </style>
</resources>
