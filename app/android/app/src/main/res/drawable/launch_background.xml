<?xml version="1.0" encoding="utf-8"?>
<!-- Splash shown by Android while the Flutter engine boots. Termex is
     dark-themed only; matching the launch background to TermexColors
     prevents the brief white flash the Flutter default produces. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/termex_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
