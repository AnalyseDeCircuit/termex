<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Termex is dark-themed regardless of system setting; force the
         splash to the Black variant so day-mode users don't see a white
         flash before Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Light status-bar icons over our dark background; mirrors what
             SystemChrome.setSystemUIOverlayStyle requests post-boot. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/termex_background_secondary</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/termex_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/termex_background_secondary</item>
    </style>
</resources>
